{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "existingClusterIdSecret",
    "image",
    "storage",
    "heapOpts"
  ],
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "enum": [
        1,
        3
      ]
    },
    "existingClusterIdSecret": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "clusterDomain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy",
        "pullSecrets"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9./:_-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "size",
        "storageClass"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "heapOpts": {
      "type": "string",
      "minLength": 1
    }
  }
}
