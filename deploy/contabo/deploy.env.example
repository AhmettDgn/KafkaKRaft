# Installed once at /etc/kafka-kraft/deploy.env; root:deploy-group 0640.
# Manual invocation only. There is no GitHub push trigger.
NAMESPACE=kafka-lab
RELEASE_NAME=kafka-lab
KUBECONFIG=/etc/kafka-kraft/deployer.kubeconfig
VALUES_FILE=/etc/kafka-kraft/lab-values.yaml
REPORT_DIR=/var/log/kafka-lab
HELM_TIMEOUT=15m
