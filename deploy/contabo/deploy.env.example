# Copy to /etc/kafka-kraft/deploy.env on the Contabo server; do not keep the
# real file in the Git repository. It may reference secrets via existing
# Kubernetes Secret names, but must not contain plaintext credentials.

DEPLOY_ENABLED=false
DEPLOY_DIR=/opt/kafka-cluster-kraft
DEPLOY_BRANCH=main
RELEASE_NAME=kafka-kraft
NAMESPACE=kafka
VALUES_FILE=/etc/kafka-kraft/values-production.yaml
HELM_TIMEOUT=15m

# Set this only after the chart has been ported and the Bitnami runtime paths
# have been removed. The remote deploy script deliberately blocks the current
# unported chart.
ALLOW_UNPORTED_BITNAMI_CHART=false

# Optional. Set it when the deployment user uses a non-default kubeconfig.
# KUBECONFIG=/home/deployer/.kube/config
